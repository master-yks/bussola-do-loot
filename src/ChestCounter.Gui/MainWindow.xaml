                                        </UniformGrid>

                                        <Button x:Name="ResetButton" Content="Zerar Histórico Salvo" Style="{StaticResource Quiet}"
                                                Margin="0,8,0,0" Padding="10,6" Click="ResetButton_Click"
                                                ToolTip="Apaga o cache salvo (os arquivos .replay que ainda estão na pasta do Fortnite poderão ser sincronizados novamente)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== WORKSPACE 4: ESTÚDIO DE PERSONALIZAÇÃO DO OVERLAY ==================== -->
                <ScrollViewer x:Name="OverlayStudioScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid x:Name="OverlayStudioGrid" Margin="0,0,2,4">
