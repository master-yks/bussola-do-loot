                                        </Border>
                                        <TextBlock Text="Prévia Ao Vivo no Jogo" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Simulated Game Scene Viewport -->
                                    <Border x:Name="PreviewViewportBorder" Height="186" CornerRadius="11" BorderBrush="{StaticResource StrokeLit}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Canvas x:Name="PreviewSceneCanvas" IsHitTestVisible="False" SizeChanged="PreviewSceneCanvas_SizeChanged"/>

                                            <!-- Scene Selector Pills inside Top-Right of Viewport -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                    Background="#B8080B12" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="7" Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="SceneSkyRadio" Style="{StaticResource Pill}" Content="☀ Céu" Tag="0" GroupName="bgscene" Padding="7,3" FontSize="10.5" IsChecked="True" Checked="PreviewBackdrop_Checked"
                                                                 ToolTip="Testar visibilidade contra o céu azul claro do Fortnite"/>
                                                    <RadioButton x:Name="SceneSnowRadio" Style="{StaticResource Pill}" Content="❄ Neve" Tag="1" GroupName="bgscene" Padding="7,3" FontSize="10.5" Checked="PreviewBackdrop_Checked"
                                                                 ToolTip="Teste extremo de contraste em bioma branco de neve"/>
                                                    <RadioButton x:Name="SceneIslandRadio" Style="{StaticResource Pill}" Content="🌿 Ilha" Tag="2" GroupName="bgscene" Padding="7,3" FontSize="10.5" Checked="PreviewBackdrop_Checked"
                                                                 ToolTip="Terreno de combate verde e dourado"/>
                                                    <RadioButton x:Name="SceneNightRadio" Style="{StaticResource Pill}" Content="🌙 Noite" Tag="3" GroupName="bgscene" Padding="7,3" FontSize="10.5" Checked="PreviewBackdrop_Checked"
                                                                 ToolTip="Ambiente noturno / caverna escura"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Actual 1:1 Rendered OverlayHudView -->
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,34,14,24">
                                                <local:OverlayHudView x:Name="PreviewHudView"/>
                                            </Viewbox>

                                            <!-- Subtle Viewport Hint -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,8,7"
                                                    Background="#9E07090F" CornerRadius="5" Padding="7,2" IsHitTestVisible="False">
                                                <TextBlock x:Name="PreviewHintText" Text="Simulação real 1:1 · teste em Céu e Neve para conferir a leitura"
                                                           Foreground="#DCE4F0" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Simulation & Quick HUD Controls -->
                                    <UniformGrid Columns="2" Margin="0,9,0,0">
                                        <Button x:Name="PreviewSimPulseButton" Content="✨ Simular +1 Baú" Style="{StaticResource Quiet}" Margin="0,0,4,0" Padding="8,5.5" FontSize="11.5"
                                                Click="PreviewSimPulseButton_Click"
                                                ToolTip="Simula a abertura de um baú na partida para testar o contador ao vivo e a animação +1"/>
                                        <Button x:Name="PreviewToggleStateButton" Content="Modo Prévia: Ao Vivo" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="8,5.5" FontSize="11.5"
                                                Click="PreviewToggleStateButton_Click"
                                                ToolTip="Alterna a prévia entre Em Partida (Ao Vivo) e Aguardando no Lobby (Espera)"/>
                                    </UniformGrid>

                                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,11,0,10"/>

                                    <CheckBox x:Name="InGameOverlayCheck" Content="Exibir contador flutuante sobre o Fortnite" Click="InGameOverlay_Toggled"/>
                                    <CheckBox x:Name="OverlayLockCheck" Content="Fixar overlay (cliques atravessam direto p/ o jogo)" Margin="0,8,0,0" Click="OverlayLock_Toggled"
                                              ToolTip="Quando fixado, você pode mirar e atirar normalmente sobre o overlay sem clicar nele"/>

                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <Button x:Name="OverlayLockButton" Content="🔒 Fixar Overlay" Style="{StaticResource Quiet}" Margin="0,0,4,0" Padding="8,6" FontSize="11.5"
                                                Click="OverlayLockButton_Click"/>
                                        <Button x:Name="CyclePresetQuickButton" Content="🎨 Próximo Estilo" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="8,6" FontSize="11.5"
                                                Click="CyclePresetButton_Click"
                                                ToolTip="Alterna rapidamente para o próximo estilo visual (Atalho dentro da partida: Ctrl+Shift+M)"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Smart Fortnite Screen Anchors -->
                            <Border Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="16,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="OverlayCoordsText" DockPanel.Dock="Right" Text="Posição livre" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Posição Rápida no Fortnite" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>

                                    <UniformGrid Columns="2">
                                        <Button x:Name="AnchorTopLeftBtn" Content="↖ Topo Esquerdo" Tag="top_left" Style="{StaticResource Quiet}" Margin="0,0,4,6" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Canto superior esquerdo da tela"/>
                                        <Button x:Name="AnchorTopCenterBtn" Content="⬆ Topo Central" Tag="top_center" Style="{StaticResource Quiet}" Margin="4,0,0,6" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Centralizado no topo (ótimo para o estilo Pílula Minimalista)"/>
                                        <Button x:Name="AnchorBesideMapBtn" Content="🗺 Ao Lado do Minimapa" Tag="beside_minimap" Style="{StaticResource Quiet}" Margin="0,0,4,6" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Encaixa no topo à esquerda do minimapa do Fortnite sem cobrir o mapa"/>
                                        <Button x:Name="AnchorBelowMapBtn" Content="↘ Abaixo do Minimapa" Tag="below_minimap" Style="{StaticResource Quiet}" Margin="4,0,0,6" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Encaixa na lateral direita logo abaixo do minimapa e contadores da partida"/>
                                        <Button x:Name="AnchorBottomLeftBtn" Content="↙ Base Esquerda" Tag="bottom_left" Style="{StaticResource Quiet}" Margin="0,0,4,0" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Canto inferior esquerdo da tela"/>
                                        <Button x:Name="AnchorBottomRightBtn" Content="↘ Base Direita" Tag="bottom_right" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="8,5.5" FontSize="11.5" Click="OverlayAnchor_Click"
                                                ToolTip="Canto inferior direito da tela"/>
                                    </UniformGrid>

                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,9,0,0">
                                        <TextBlock Style="{StaticResource Label}" FontSize="10.8" TextWrapping="Wrap" LineHeight="15.5">
                                            <Run Text="Atalhos na partida:" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                            <Run Text=" Ctrl+Shift+O mostra/oculta · Ctrl+Shift+L trava cliques · "/>
                                            <Run Text="Ctrl+Shift+M troca o estilo ao vivo!" Foreground="{StaticResource Gold}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- OBS Browser Source Integration -->
                            <Border Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="OverlayUrlText" DockPanel.Dock="Right" Text="http://localhost:7777/" Foreground="{StaticResource Gold}"
                                                   FontSize="11.5" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="CopyObsUrl_Click"
                                                   ToolTip="Clique para copiar o endereço da Fonte Navegador do OBS"/>
                                        <TextBlock Text="OBS Studio / Streamlabs" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="SyncObsCheck" Content="Sincronizar estilo, cores e transparência com o OBS" Margin="0,9,0,0" Click="OverlayToggleOption_Changed"/>
                                    <UniformGrid Columns="2" Margin="0,9,0,0">
                                        <Button Content="Copiar URL OBS" Style="{StaticResource Quiet}" Margin="0,0,4,0" Padding="8,5.5" FontSize="11.5" Click="CopyObsUrlButton_Click"/>
                                        <Button Content="Abrir no Navegador" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="8,5.5" FontSize="11.5" Click="OpenObsBrowserButton_Click"/>
                                    </UniformGrid>
                                    <TextBlock x:Name="OverlayStatusText" Text="" Style="{StaticResource Label}" FontSize="10.8" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: PRESET GALLERY & GRANULAR CUSTOMIZATION -->
                        <StackPanel x:Name="OverlayStudioRightPanel" Grid.Column="1" Grid.Row="0">
                            <!-- Section 1: 9 Curated Visual Presets -->
                            <Border Style="{StaticResource Panel}" Padding="16,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="↺ Restaurar Padrão Fortnite" Style="{StaticResource Quiet}"
                                                Padding="9,4" FontSize="11" Click="ResetDefaultOverlayStyle_Click"
                                                ToolTip="Restaura o estilo padrão recomendado (Fortnite Tático Transparente)"/>
                                        <StackPanel>
                                            <TextBlock Text="Galeria de Estilos (9 Presets)" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Escolha uma estética pronta ou personalize cada detalhe abaixo como preferir" Style="{StaticResource Label}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <UniformGrid x:Name="PresetCardsGrid" Columns="3" Margin="0,2,-6,-6"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Layout, Frame, Font & Transparency Sliders -->
                            <Border Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Formato, Moldura &amp; Visibilidade Transparente" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>

                                    <!-- Layout Mode -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Layout" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                            <WrapPanel Orientation="Horizontal">
                                                <RadioButton x:Name="LayoutTacticalRadio" Style="{StaticResource Pill}" Content="⚡ Fortnite Tático" Tag="tactical" GroupName="hudlayout" Padding="9,4" FontSize="11.5" Checked="HudLayout_Checked"/>
                                                <RadioButton x:Name="LayoutPillRadio" Style="{StaticResource Pill}" Content="💊 Barra 1 Linha" Tag="pill" GroupName="hudlayout" Padding="9,4" FontSize="11.5" Checked="HudLayout_Checked"/>
                                                <RadioButton x:Name="LayoutMicroRadio" Style="{StaticResource Pill}" Content="🎯 Micro HUD" Tag="micro" GroupName="hudlayout" Padding="9,4" FontSize="11.5" Checked="HudLayout_Checked"/>
                                                <RadioButton x:Name="LayoutVerticalRadio" Style="{StaticResource Pill}" Content="📐 Coluna Lateral" Tag="vertical" GroupName="hudlayout" Padding="9,4" FontSize="11.5" Checked="HudLayout_Checked"/>
                                                <RadioButton x:Name="LayoutCardRadio" Style="{StaticResource Pill}" Content="📊 Cartão Completo" Tag="card" GroupName="hudlayout" Padding="9,4" FontSize="11.5" Checked="HudLayout_Checked"/>
                                            </WrapPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Chrome / Frame Style -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Moldura" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                            <WrapPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ChromeAngledRadio" Style="{StaticResource Pill}" Content="▱ Inclinado Fortnite" Tag="angled" GroupName="hudchrome" Padding="9,4" FontSize="11.5" Checked="HudChrome_Checked"/>
                                                <RadioButton x:Name="ChromeCapsuleRadio" Style="{StaticResource Pill}" Content="◖ Cápsula" Tag="capsule" GroupName="hudchrome" Padding="9,4" FontSize="11.5" Checked="HudChrome_Checked"/>
                                                <RadioButton x:Name="ChromeGlassRadio" Style="{StaticResource Pill}" Content="▢ Vidro Suave" Tag="glass" GroupName="hudchrome" Padding="9,4" FontSize="11.5" Checked="HudChrome_Checked"/>
                                                <RadioButton x:Name="ChromeSharpRadio" Style="{StaticResource Pill}" Content="▭ Reto Esports" Tag="sharp" GroupName="hudchrome" Padding="9,4" FontSize="11.5" Checked="HudChrome_Checked"/>
                                                <RadioButton x:Name="ChromeNoneRadio" Style="{StaticResource Pill}" Content="👻 Sem Fundo" Tag="none" GroupName="hudchrome" Padding="9,4" FontSize="11.5" Checked="HudChrome_Checked"/>
                                            </WrapPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Font Family -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fonte" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                            <WrapPanel Orientation="Horizontal">
                                                <RadioButton x:Name="FontFortniteRadio" Style="{StaticResource Pill}" Content="Fortnite Condensada" Tag="fortnite" GroupName="hudfont" Padding="9,4" FontSize="11.5" Checked="HudFont_Checked"/>
                                                <RadioButton x:Name="FontModernRadio" Style="{StaticResource Pill}" Content="Moderna Limpa" Tag="modern" GroupName="hudfont" Padding="9,4" FontSize="11.5" Checked="HudFont_Checked"/>
                                                <RadioButton x:Name="FontMonoRadio" Style="{StaticResource Pill}" Content="Competitiva Mono" Tag="mono" GroupName="hudfont" Padding="9,4" FontSize="11.5" Checked="HudFont_Checked"/>
                                            </WrapPanel>
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,9"/>

                                    <!-- 5 Precision Sliders -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="154"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="27"/>
                                            <RowDefinition Height="27"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Opacidade do Fundo" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"
                                                   ToolTip="0% deixa totalmente sem caixa de fundo; 30–40% cria um vidro leve estilo Fortnite"/>
                                        <Slider x:Name="BgOpacitySlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="34" ValueChanged="OverlaySlider_Changed"/>
                                        <TextBlock x:Name="BgOpacityValueText" Grid.Row="0" Grid.Column="2" Text="34%" Foreground="{StaticResource Gold}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Text="Contorno dos Números" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"
                                                   ToolTip="Borda escura nítida ao redor das letras para garantir leitura perfeita mesmo contra céu claro ou neve"/>
                                        <Slider x:Name="TextStrokeSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="32" Value="16.5" ValueChanged="OverlaySlider_Changed"/>
                                        <TextBlock x:Name="TextStrokeValueText" Grid.Row="1" Grid.Column="2" Text="1,7 px" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Text="Tamanho (Escala)" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                        <Slider x:Name="ScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="65" Maximum="165" Value="100" ValueChanged="OverlaySlider_Changed"/>
                                        <TextBlock x:Name="ScaleValueText" Grid.Row="2" Grid.Column="2" Text="100%" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Text="Brilho da Moldura" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                        <Slider x:Name="BorderStrengthSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="36" ValueChanged="OverlaySlider_Changed"/>
                                        <TextBlock x:Name="BorderStrengthValueText" Grid.Row="3" Grid.Column="2" Text="36%" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Text="Opacidade Geral" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                        <Slider x:Name="HudOpacitySlider" Grid.Row="4" Grid.Column="1" Minimum="25" Maximum="100" Value="98" ValueChanged="OverlaySlider_Changed"/>
                                        <TextBlock x:Name="HudOpacityValueText" Grid.Row="4" Grid.Column="2" Text="98%" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Colors & Header Branding -->
                            <Border Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Cores &amp; Identidade Visual" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Destaque" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="AccentSwatch" Width="20" Height="20" CornerRadius="5" BorderBrush="#44FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="AccentBox" Width="82" Padding="8,4" FontSize="11.5" TextChanged="Accent_Changed" ToolTip="Cor principal (baús da partida e barra lateral)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#F5B942" Tag="#F5B942" Margin="7,0,0,0" Click="Preset_Click" ToolTip="Ouro Mítico (#F5B942)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#00F5D4" Tag="#00F5D4" Click="Preset_Click" ToolTip="Slurp Neon (#00F5D4)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#38BDF8" Tag="#38BDF8" Click="Preset_Click" ToolTip="Azul Raro Fortnite (#38BDF8)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#E879F9" Tag="#E879F9" Click="Preset_Click" ToolTip="Épico Ponto Zero (#E879F9)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#FB923C" Tag="#FB923C" Click="Preset_Click" ToolTip="Lendário Laranja (#FB923C)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#FF3D6B" Tag="#FF3D6B" Click="Preset_Click" ToolTip="Rubi Carmesim (#FF3D6B)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#3DDC84" Tag="#3DDC84" Click="Preset_Click" ToolTip="Verde Incomum (#3DDC84)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="Preset_Click" ToolTip="Branco Puro (#FFFFFF)"/>
                                        </WrapPanel>

                                        <TextBlock Grid.Row="1" Text="Secundária" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <Border x:Name="SecondarySwatch" Width="20" Height="20" CornerRadius="5" BorderBrush="#44FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="SecondaryBox" Width="82" Padding="8,4" FontSize="11.5" TextChanged="SecondaryAccent_Changed" ToolTip="Cor de destaque para Token Pirata e Hora do Tesouro"/>
                                            <Button Style="{StaticResource Swatch}" Background="#4CC9F0" Tag="#4CC9F0" Margin="7,0,0,0" Click="SecondaryPreset_Click" ToolTip="Ciano Celeste (#4CC9F0)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#F5B942" Tag="#F5B942" Click="SecondaryPreset_Click" ToolTip="Ouro Pirata (#F5B942)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#3DDC84" Tag="#3DDC84" Click="SecondaryPreset_Click" ToolTip="Esmeralda (#3DDC84)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#FF3D6B" Tag="#FF3D6B" Click="SecondaryPreset_Click" ToolTip="Carmesim (#FF3D6B)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#A78BFA" Tag="#A78BFA" Click="SecondaryPreset_Click" ToolTip="Violeta (#A78BFA)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#F8FAFC" Tag="#F8FAFC" Click="SecondaryPreset_Click" ToolTip="Gelo Claro (#F8FAFC)"/>
                                        </WrapPanel>

                                        <TextBlock Grid.Row="2" Text="Tom do Vidro" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                            <Border x:Name="BgColorSwatch" Width="20" Height="20" CornerRadius="5" BorderBrush="#44FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BgHexBox" Width="82" Padding="8,4" FontSize="11.5" TextChanged="BgHex_Changed" ToolTip="Cor base da placa translúcida de fundo"/>
                                            <Button Style="{StaticResource Swatch}" Background="#0A0F1A" Tag="#0A0F1A" Margin="7,0,0,0" Click="BgPreset_Click" ToolTip="Obsidiana Tática (#0A0F1A)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#07182B" Tag="#07182B" Click="BgPreset_Click" ToolTip="Azul Noite Fortnite (#07182B)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#150926" Tag="#150926" Click="BgPreset_Click" ToolTip="Roxo Tempestade (#150926)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#161008" Tag="#161008" Click="BgPreset_Click" ToolTip="Âmbar Pirata (#161008)"/>
                                            <Button Style="{StaticResource Swatch}" Background="#000000" Tag="#000000" Click="BgPreset_Click" ToolTip="Preto Puro (#000000)"/>
                                        </WrapPanel>

                                        <TextBlock Grid.Row="3" Text="Título" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox x:Name="TitleBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Padding="9,4.5" FontSize="12" TextChanged="Title_Changed"
                                                 ToolTip="Exibido quando a opção 'Cabeçalho com título e status' está ativada"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Modular Metrics & Smart Behavior -->
                            <Border Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Informações Visíveis &amp; Comportamento em Partida" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                    <UniformGrid x:Name="OverlayChecksUniformGrid" Columns="2">
                                        <CheckBox x:Name="HudShowIconCheck" Content="Ícone de baú + luz de status" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowLiveCheck" Content="Baús nesta partida (Ao vivo)" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowSeasonCheck" Content="Total acumulado na temporada" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowTokenCheck" Content="Chance do Token Loja Pirata" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowAvgCheck" Content="Média de baús por partida" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowLastCheck" Content="Baús da última partida" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowBestCheck" Content="Recorde pessoal de baús" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowHourCheck" Content="Cronômetro Hora do Tesouro" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowLabelsCheck" Content="Rótulos curtos (PARTIDA, TEMP…)" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudShowHeaderCheck" Content="Cabeçalho com título e status" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudAccentBarCheck" Content="Barra lateral luminosa Fortnite" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudTextShadowCheck" Content="Sombra projetada de leitura" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudPulseCheck" Content="Animação +1 ao abrir novo baú" Margin="0,0,8,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                        <CheckBox x:Name="HudDimIdleCheck" Content="Suavizar brilho fora de partida" Margin="0,0,0,7" FontSize="12" Click="OverlayToggleOption_Changed"/>
                                    </UniformGrid>

                                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,2,0,8"/>
                                    <CheckBox x:Name="HudHideIdleCheck" Content="Ocultar automaticamente no Lobby (aparecer apenas durante a partida quando fixado 🔒)"
                                              FontSize="12" Click="OverlayToggleOption_Changed"
                                              ToolTip="Quando fixado (Ctrl+Shift+L), o HUD fica 100% invisível fora da partida e surge sozinho assim que você abre o 1º baú"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== FOOTER ==================== -->
                <Grid Grid.Row="2" Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="FooterText" Text="master-yks" Foreground="{StaticResource Steel}" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock x:Name="FooterSummaryText" Text="" Style="{StaticResource Label}" FontSize="11.5" Margin="10,0,12,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ProgressBar x:Name="ScanProgressBar" Width="120" Height="5" Margin="0,0,10,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource Gold}" Background="{StaticResource CardAlt}" BorderThickness="0"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
