                                            <Button Content="Pasta de Replays" Style="{StaticResource Quiet}" Margin="0,0,4,0" Padding="10,6" Click="OpenDemosFolderButton_Click"
                                                    ToolTip="Abre a pasta %LOCALAPPDATA%\FortniteGame\Saved\Demos"/>
                                            <Button Content="Pasta de Dados" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="10,6" Click="OpenDataFolderButton_Click"
