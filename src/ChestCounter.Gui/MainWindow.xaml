<Window x:Class="ChestCounter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChestCounter.Gui"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Language="pt-BR" Title="Bússola do Loot — master-yks"
        Width="1300" Height="734" MinWidth="760" MinHeight="520"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Icon="Assets/token.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="180" ToolTipService.BetweenShowDelay="60" ToolTipService.ShowDuration="18000"
        SizeChanged="MainWindow_SizeChanged" LocationChanged="MainWindow_LocationChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowRootBorder" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== CUSTOM OBSIDIAN TITLE BAR ==================== -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title (Draggable Window Caption Region) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                        <Image Source="Assets/token.png" Width="23" Height="20" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Bússola do Loot" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource GoldBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="6,1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CAÇADORES DE TESOURO" Foreground="{StaticResource Gold}" FontSize="9.5" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="TitleBarAuthorText" Text="·  master-yks" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    </StackPanel>

                    <!-- Quick In-Game HUD, Style & Lock Toggles in Title Bar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="TitleHudQuickButton" Style="{StaticResource Quiet}"
                                Content="HUD no Jogo: OFF" Padding="10,3" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleHudQuickButton_Click"
                                ToolTip="Mostra ou oculta o contador flutuante sobre o Fortnite (Atalho: Ctrl+Shift+O)"/>
                        <Button x:Name="TitleHudStyleButton" Style="{StaticResource Quiet}"
                                Content="🎨 Estilo" Padding="9,3" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleHudStyleButton_Click"
                                ToolTip="Abre o estúdio de estilos e transparência do overlay (Ciclar no jogo: Ctrl+Shift+M)"/>
                        <Button x:Name="TitleHudLockButton" Style="{StaticResource Quiet}"
                                Content="🔓 Móvel" Padding="9,3" FontSize="11" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleHudLockButton_Click"
                                ToolTip="Fixa o overlay para impedir cliques acidentais durante o jogo (Atalho: Ctrl+Shift+L)"/>
                    </StackPanel>

                    <!-- Native-Feel Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" ToolTip="Minimizar janela">
                            <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButton}" Click="MaximizeRestoreWindow_Click" ToolTip="Maximizar ou restaurar tamanho">
                            <Path x:Name="MaxRestoreIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="Fechar">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN APPLICATION BODY ==================== -->
            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="20,12,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== ADAPTIVE NAVIGATION & ACTION BAR ==================== -->
                <Grid x:Name="ToolbarGrid" Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Workspace Navigation Tabs -->
                    <Border x:Name="NavTabsBorder" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="9" Padding="3">
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabOverview" Style="{StaticResource NavTab}" Content="Visão Geral" GroupName="nav" IsChecked="True" Checked="WorkspaceTab_Checked"/>
                            <RadioButton x:Name="TabMap" Style="{StaticResource NavTab}" Content="Mapa" GroupName="nav" Checked="WorkspaceTab_Checked"/>
                            <RadioButton x:Name="TabProbabilities" Style="{StaticResource NavTab}" Content="Probabilidades" GroupName="nav" Checked="WorkspaceTab_Checked"/>
                            <RadioButton x:Name="TabOverlay" Style="{StaticResource NavTab}" Content="Estúdio do HUD" GroupName="nav" Checked="WorkspaceTab_Checked"/>
                            <RadioButton x:Name="TabHistory" Style="{StaticResource NavTab}" Content="Histórico" GroupName="nav" Checked="WorkspaceTab_Checked"/>
                        </WrapPanel>
                    </Border>

                    <!-- Period Filter & Live/Sync Actions -->
                    <WrapPanel x:Name="ControlsRightPanel" Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                CornerRadius="8" Padding="3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="F0" Style="{StaticResource Pill}" Content="24h" Tag="0" GroupName="f" Checked="Filter_Checked"
                                             ToolTip="Filtra estatísticas das últimas 24 horas"/>
                                <RadioButton x:Name="F1" Style="{StaticResource Pill}" Content="7 dias" Tag="1" GroupName="f" Checked="Filter_Checked"
                                             ToolTip="Filtra estatísticas dos últimos 7 dias"/>
                                <RadioButton x:Name="F2" Style="{StaticResource Pill}" Content="Temporada" Tag="2" GroupName="f" Checked="Filter_Checked" IsChecked="True"
                                             ToolTip="Exibe todas as partidas válidas da Temporada Pirata atual"/>
                                <RadioButton x:Name="F3" Style="{StaticResource Pill}" Content="Tudo" Tag="3" GroupName="f" Checked="Filter_Checked"
                                             ToolTip="Exibe todo o histórico de partidas salvo"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LiveButton" Content="● Ao vivo ligado" Style="{StaticResource Quiet}" Click="LiveButton_Click"
                                ToolTip="Ativa ou pausa a leitura óptica (OCR) em tempo real e o monitoramento automático de replays"/>
                        <Button x:Name="ScanButton" Content="Sincronizar" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="ScanButton_Click"
                                ToolTip="Varre todos os replays do Fortnite em múltiplos núcleos do processador sem perder nenhum baú"/>
                    </WrapPanel>
                </Grid>

                <Border x:Name="MapHost" Grid.Row="1" Visibility="Collapsed"/>
                <!-- ==================== WORKSPACE 1: VISÃO GERAL ==================== -->
                <ScrollViewer x:Name="OverviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <Grid x:Name="OverviewGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OverviewLeftCol" Width="*"/>
                            <ColumnDefinition x:Name="OverviewRightCol" Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LEFT COLUMN -->
                        <Grid x:Name="OverviewLeftPanel" Grid.Column="0" Grid.Row="0" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="168"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Dual Hero Panel: Season Total + Live Match -->
                            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="HeroDualGrid" Grid.Row="0" MinHeight="138">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="HeroLeftCol" Width="1.12*"/>
                                            <ColumnDefinition x:Name="HeroRightCol" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Left Hero: Accumulated Season Chests -->
                                        <Border x:Name="HeroLeftBorder" Background="{StaticResource HeroBrush}" Grid.Column="0" Grid.Row="0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0" Padding="22,14,18,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Border x:Name="SyncBadgeBorder" Background="{StaticResource EmeraldSoft}" BorderBrush="#443DDC84" BorderThickness="1"
                                                            CornerRadius="5" Padding="7,2">
                                                        <TextBlock x:Name="SyncBadgeText" Text="✓ Contagem automática da temporada" Foreground="{StaticResource Emerald}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border x:Name="SeasonLiveDeltaBadge" Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource GoldBorder}" BorderThickness="1"
                                                            CornerRadius="5" Padding="7,2" Margin="7,0,0,0" Visibility="Collapsed">
                                                        <TextBlock x:Name="SeasonLiveDeltaText" Text="+0 ao vivo" Foreground="{StaticResource Gold}" FontSize="10.5" FontWeight="Bold"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="Seus baús na temporada" Foreground="{StaticResource Steel}" FontSize="12.5" Margin="0,7,0,0"/>
                                                <TextBlock x:Name="SeasonHeroTotalText" Text="0" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}"
                                                           FontSize="68" FontWeight="Bold" Margin="-2,-8,0,-7"/>
                                                <TextBlock x:Name="SeasonHeroSubText" Text="Sincronizando replays da temporada…" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Right Hero: Current Live Match -->
                                        <Grid x:Name="HeroRightGrid" Grid.Column="1" Grid.Row="0" ClipToBounds="True">
                                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" IsHitTestVisible="False">
                                                <Ellipse Width="320" Height="240" Canvas.Left="-220" Canvas.Top="-30">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#4564C8B7" Offset="0"/>
                                                            <GradientStop Color="#0064C8B7" Offset="1"/>
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Canvas>
                                            <Image x:Name="HeroChestImage" Source="chest.png" Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,4,16,0" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                                            <StackPanel x:Name="HeroLiveStack" Margin="22,14,136,12" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="LiveDotEllipse" Width="8" Height="8" Fill="{StaticResource Gem}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                                    <TextBlock Text="Partida ao vivo" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ThisGameText" Text="—" Style="{StaticResource Figure}" FontSize="68" FontWeight="Bold" Margin="-2,-8,0,-7"/>
                                                <TextBlock x:Name="ThisGameSubText" Text="Aguardando partida…" Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- 4-Column Summary Strip -->
                                    <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Background="#08FFFFFF">
                                        <UniformGrid x:Name="HeroStatsStrip" Columns="4">
                                            <Border Background="Transparent" Padding="20,9,10,9" x:Name="KpiAvgCard">
                                                <StackPanel>
                                                    <TextBlock Text="Média por Partida" Style="{StaticResource Label}" FontSize="11.5"/>
                                                    <TextBlock x:Name="AvgYouText" Text="0,0" Style="{StaticResource Figure}" FontSize="30" Margin="0,-2,0,-2"/>
                                                    <TextBlock x:Name="RecentFormText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="16,9,10,9" x:Name="KpiPeriodCard">
                                                <StackPanel>
                                                    <TextBlock x:Name="PeriodLabelText" Text="Baús no Período" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="YourTotalText" Text="0" Style="{StaticResource Figure}" FontSize="30" Margin="0,-2,0,-2"/>
                                                    <TextBlock x:Name="MatchesText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="16,9,10,9" x:Name="KpiBestCard">
                                                <StackPanel>
                                                    <TextBlock Text="Última / Recorde" Style="{StaticResource Label}" FontSize="11.5"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,-2,0,-2">
                                                        <TextBlock x:Name="LastGameText" Text="—" Style="{StaticResource Figure}" FontSize="30"/>
                                                        <TextBlock Text=" · máx " Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="3,0,2,5"/>
                                                        <TextBlock x:Name="BestText" Text="0" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gem}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LastMatchText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource ClickableTokenCard}" BorderThickness="1,0,0,0" Padding="16,9,10,9" x:Name="KpiTokenCard"
                                                    MouseLeftButtonUp="OpenProbabilitiesTab_Click"
                                                    ToolTip="Clique para abrir os gráficos interativos e simulações de probabilidade acumulada">
                                                <StackPanel>
                                                    <TextBlock Text="Chance Token Loja Pirata" Foreground="{StaticResource Gold}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="HeroTokenChanceText" Text="0,000%" Style="{StaticResource Figure}" FontSize="30" Foreground="{StaticResource Gold}" Margin="0,-2,0,-2"/>
                                                    <TextBlock x:Name="HeroTokenSubText" Text="ver gráficos →" Foreground="#CCA86B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,9">
                                        <TextBlock x:Name="ChestKindsPeriodText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Seus baús por tipo" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="ChestKindList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,0" Padding="4,7" Background="{StaticResource CardAlt}"
                                                        CornerRadius="8" ToolTip="{Binding Hint}">
                                                    <StackPanel>
                                                        <Grid Width="88" Height="60" HorizontalAlignment="Center">
                                                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Border Visibility="{Binding BuriedMarker}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Background="#352A1C" BorderBrush="#C99856" BorderThickness="1" CornerRadius="8" Padding="4">
                                                                <!-- A crossed mark on a folded treasure map denotes the dig site. -->
                                                                <Path Width="17" Height="15" Stretch="Uniform" Stroke="#FFE2A0" StrokeThickness="1.6"
                                                                      StrokeLineJoin="Round" Data="M1,4 L7,1 L13,4 L19,1 L19,14 L13,17 L7,14 L1,17 Z M8,6 L13,12 M13,6 L8,12"/>
                                                            </Border>
                                                            <Image Source="Assets/poster.png" Visibility="{Binding PosterMarker}" Width="20" Height="29"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Color}" FontSize="24" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Steel}" FontSize="12" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel VerticalAlignment="Center" Margin="2,7,0,0" ToolTip="As duas aparências entram na contagem de baús de Elemental ou do cartaz, conforme a origem registrada.">
                                        <TextBlock Text="Variantes de Elemental" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Image Source="Assets/sprite-fortune.png" Width="48" Height="43" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Fortuna" Foreground="{StaticResource Steel}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/sprite-cursed.png" Width="48" Height="43" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Amaldiçoado" Foreground="{StaticResource Steel}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="ChestKindNote" Style="{StaticResource Label}" Margin="2,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Match-by-Match Vector Bar Chart -->
                            <Border x:Name="MatchChartBorder" Grid.Row="2" Style="{StaticResource Panel}" Margin="0,11,0,0" Padding="18,12,18,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="ChartMetaText" DockPanel.Dock="Right" Text="" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Baús por partida" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="ChartSubtitleHint" Text="  ·  passe o mouse nas barras para inspecionar" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1" ClipToBounds="True">
                                        <TextBlock x:Name="NoDataText" Text="Nenhuma partida encontrada neste período. Jogue uma partida ou clique em Sincronizar."
                                                   Style="{StaticResource Label}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                                        <Canvas x:Name="MatchChartCanvas" Background="Transparent" ClipToBounds="True"
                                                SizeChanged="MatchChartCanvas_SizeChanged"
                                                MouseMove="MatchChartCanvas_MouseMove"
                                                MouseLeave="MatchChartCanvas_MouseLeave"/>
                                        <Border x:Name="MatchChartTooltipBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                                                Background="#F6131722" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                                CornerRadius="7" Padding="10,6" IsHitTestVisible="False" Visibility="Collapsed">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                            </Border.Effect>
                                            <TextBlock x:Name="MatchChartTooltipText" Foreground="{StaticResource Text}" FontSize="11.5" LineHeight="16.5" IsHitTestVisible="False"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Squad & Frequent Teammates -->
                            <Grid x:Name="SquadBottomGrid" Grid.Row="3" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SquadCol0" Width="*"/>
                                    <ColumnDefinition x:Name="SquadCol1" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="SquadCardBorder" Grid.Column="0" Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,6,0" MinHeight="122" Padding="16,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="SquadTotalText" DockPanel.Dock="Right" Text="" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="Último Esquadrão" Style="{StaticResource SectionTitle}"/>
                                        </DockPanel>
                                        <ItemsControl x:Name="SquadList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HoverRow}" Padding="5,2" ToolTip="{Binding Tooltip}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Steel}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Display}" Foreground="{StaticResource Text}" FontSize="16.5" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="SquadEmptyText" Text="Seus colegas de equipe aparecem aqui após partidas em grupo." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MatesCardBorder" Grid.Column="1" Grid.Row="0" Style="{StaticResource Panel}" Margin="6,0,0,0" MinHeight="122" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="Parceiros Mais Frequentes" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl x:Name="MatesList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HoverRow}" Padding="5,2.5" ToolTip="{Binding Tooltip}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Steel}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Label}" FontSize="11.5" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="MatesEmptyText" Text="O ranking de parceiros aparece após partidas em equipe." Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- RIGHT COLUMN -->
                        <ScrollViewer x:Name="OverviewRightScroll" Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource Panel}" Padding="0" VerticalAlignment="Top">
                                <StackPanel>
                                    <!-- Treasure Hour Banner -->
                                    <Border x:Name="HourBorder" Background="{StaticResource CardAlt}" CornerRadius="12,12,0,0" Padding="16,10">
                                        <StackPanel>
                                            <TextBlock x:Name="HourTitleText" Text="Próxima Hora do Tesouro" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="HourCountdownText" Text="" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}"
                                                       FontSize="38" FontWeight="SemiBold" Margin="-1,-3,0,-3"/>
                                            <TextBlock x:Name="HourBoostText" Text="" Foreground="{StaticResource Steel}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Accumulated Probabilities -->
                                    <StackPanel Margin="15,10,15,11">
                                        <DockPanel Margin="2,0,2,0">
                                            <TextBlock DockPanel.Dock="Right" Text="chance atual ⓘ" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" Cursor="Help"
                                                       ToolTip="Probabilidade exata de Bernoulli 1 − (1 − 1/k)^N acumulada com todos os baús abertos nesta temporada. Passe o mouse sobre qualquer item abaixo para ver detalhes completos."/>
                                            <TextBlock x:Name="WeekText" Text="Chances Acumuladas" Style="{StaticResource SectionTitle}"/>
                                        </DockPanel>

                                        <ItemsControl x:Name="OddsList" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HoverRow}" Padding="5,2.5" Margin="0,0.5" ToolTip="{Binding Tooltip}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="64"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Item}" Style="{StaticResource Label}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Odds}" Foreground="{Binding OddsBrush}" FontFamily="{StaticResource Display}"
                                                                           FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Luck}" Foreground="{Binding BarBrush}" FontWeight="Bold" FontSize="11.5"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <Grid Height="3" Margin="0,2.5,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding FillStar}"/>
                                                                    <ColumnDefinition Width="{Binding EmptyStar}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding BarBrush}" CornerRadius="1.5"/>
                                                                <Border Grid.Column="1" Background="#1CFFFFFF" CornerRadius="1.5"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="Abrir Gráficos Interativos de Probabilidade →" Style="{StaticResource Quiet}"
                                                Margin="2,7,2,0" Padding="10,5" Click="OpenProbabilitiesTab_ButtonClick"/>

                                        <Border Height="1" Background="{StaticResource Stroke}" Margin="2,8,2,7"/>

                                        <TextBlock x:Name="TokenText" Text="Ficha da Loja Pirata ainda não encontrada" Foreground="{StaticResource Gold}" FontWeight="SemiBold" FontSize="11.5" Margin="2,0" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="PrizeList" Margin="0,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HoverRow}" Padding="4,1.5" ToolTip="{Binding Tooltip}">
                                                        <TextBlock Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="PrizeEmptyText" Text="Os tesouros e engenhocas obtidos nas partidas aparecem aqui."
                                                   Style="{StaticResource Label}" FontSize="11" Margin="2,3,2,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== WORKSPACE 2: GRÁFICOS DE PROBABILIDADE ==================== -->
                <ScrollViewer x:Name="ProbabilitiesGrid" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Selector & Chart Mode Controls -->
                        <Border Style="{StaticResource Panel}" Padding="14,10">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <RadioButton x:Name="ProbTokenRadio" Style="{StaticResource Pill}" Content="Token Pirata" Tag="token" GroupName="ptarget" IsChecked="True" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Traje Dourado" Tag="outfit" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Veículo" Tag="car" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Picareta" Tag="pickaxe" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Música Jam" Tag="jam" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Tela" Tag="loading" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                    <RadioButton Style="{StaticResource Pill}" Content="Engenhoca" Tag="gizmo" GroupName="ptarget" Checked="ProbTarget_Checked"/>
                                </WrapPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ShowSquadCurveCheck" Content="Incluir baús do esquadrão" IsChecked="True"
                                              VerticalAlignment="Center" Margin="0,2,12,2" Click="ProbOption_Changed"
                                              ToolTip="A Ficha da Loja Pirata e as Engenhocas são compartilhadas quando um colega de esquadrão abre o baú!"/>
                                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="7" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ZoomRangeSmart" Style="{StaticResource Pill}" Content="Zoom no Seu Ritmo" GroupName="prange" IsChecked="True" Checked="ProbRange_Checked"
                                                         ToolTip="Ajusta a escala horizontal para destacar seu progresso atual e as próximas dezenas de partidas"/>
                                            <RadioButton x:Name="ZoomRangeFull" Style="{StaticResource Pill}" Content="Curva 0–95%" GroupName="prange" Checked="ProbRange_Checked"
                                                         ToolTip="Exibe a curva assintótica completa até 95% de probabilidade acumulada"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </WrapPanel>
                        </Border>

                        <!-- 4 Mathematical KPI Cards -->
                        <UniformGrid x:Name="ProbKpiUniformGrid" Columns="4" Margin="0,10,0,0">
                            <Border Style="{StaticResource Panel}" Margin="0,0,5,5" Padding="15,10">
                                <StackPanel>
                                    <TextBlock Text="Sua Chance Acumulada (Solo)" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProbCurrentText" Text="0,000%" Style="{StaticResource Figure}" FontSize="32" Foreground="{StaticResource Gold}"/>
                                    <TextBlock x:Name="ProbCurrentSubText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="5,0,5,5" Padding="15,10">
                                <StackPanel>
                                    <TextBlock x:Name="ProbSecondaryTitleText" Text="Chance Efetiva c/ Esquadrão" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProbBoostedText" Text="0,000%" Style="{StaticResource Figure}" FontSize="32" Foreground="{StaticResource Cyan}"/>
                                    <TextBlock x:Name="ProbBoostedSubText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="5,0,5,5" Padding="15,10">
                                <StackPanel>
                                    <TextBlock Text="Projeção (+50 Partidas)" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProbProjectedText" Text="0,000%" Style="{StaticResource Figure}" FontSize="32" Foreground="{StaticResource Emerald}"/>
                                    <TextBlock x:Name="ProbProjectedSubText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="5,0,0,5" Padding="15,10">
                                <StackPanel>
                                    <TextBlock Text="Ponto de 50% (Cara ou Coroa)" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ProbHalfwayText" Text="95.308" Style="{StaticResource Figure}" FontSize="32"/>
                                    <TextBlock x:Name="ProbHalfwaySubText" Text="" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Two Interactive Vector Probability Charts -->
                        <Grid x:Name="ProbChartsGrid" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProbChartCol0" Width="1.18*"/>
                                <ColumnDefinition x:Name="ProbChartCol1" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chart 1: Cumulative Probability Curve P = 1 - (1 - p)^N -->
                            <Border x:Name="ProbCurveCardBorder" Grid.Column="0" Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,6,0" Padding="16,12" Height="276">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Taxa Base" Style="{StaticResource Label}" FontSize="11" Margin="0,0,10,0"/>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Gem}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Hora do Tesouro" Style="{StaticResource Label}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CurveChartTitleText" Text="Curva Acumulada — Ficha da Loja Pirata" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,8,0,4" ClipToBounds="True">
                                        <Canvas x:Name="ProbCurveCanvas" Background="Transparent" ClipToBounds="True"
                                                SizeChanged="ProbCurveCanvas_SizeChanged"
                                                MouseMove="ProbCurveCanvas_MouseMove"
                                                MouseLeave="ProbCurveCanvas_MouseLeave"/>
                                        <Border x:Name="ProbCurveTooltipBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                                                Background="#F6131722" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                                CornerRadius="7" Padding="10,6" IsHitTestVisible="False" Visibility="Collapsed">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                            </Border.Effect>
                                            <TextBlock x:Name="ProbCurveTooltipText" Foreground="{StaticResource Text}" FontSize="11.5" LineHeight="16.5" IsHitTestVisible="False"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="ProbCurveHoverText" Grid.Row="2"
                                               Text="Passe o mouse sobre a curva para simular qualquer quantidade de baús e partidas."
                                               Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Chart 2: Real Season Cumulative Luck Progression -->
                            <Border x:Name="SeasonProbCardBorder" Grid.Column="1" Grid.Row="0" Style="{StaticResource Panel}" Margin="6,0,0,0" Padding="16,12" Height="276">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock x:Name="HistoryProbMetaText" DockPanel.Dock="Right" Text="" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="HistoryProbTitleText" Text="Sua Evolução Real na Temporada" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,8,0,4" ClipToBounds="True">
                                        <Canvas x:Name="SeasonProbCanvas" Background="Transparent" ClipToBounds="True"
                                                SizeChanged="SeasonProbCanvas_SizeChanged"
                                                MouseMove="SeasonProbCanvas_MouseMove"
                                                MouseLeave="SeasonProbCanvas_MouseLeave"/>
                                        <Border x:Name="SeasonProbTooltipBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                                                Background="#F6131722" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                                CornerRadius="7" Padding="10,6" IsHitTestVisible="False" Visibility="Collapsed">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                            </Border.Effect>
                                            <TextBlock x:Name="SeasonProbTooltipText" Foreground="{StaticResource Text}" FontSize="11.5" LineHeight="16.5" IsHitTestVisible="False"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="SeasonProbHoverText" Grid.Row="2"
                                               Text="Mostra como sua chance acumulada cresceu da 1ª partida até agora."
                                               Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Full 7-Tier Probability Matrix & Simulator -->
                        <Border Style="{StaticResource Panel}" Margin="0,12,0,4" Padding="18,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="Fórmula exata: P(≥1) = 1 − (1 − 1/k)^N" Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Matriz Completa de Probabilidades &amp; Projeções de Temporada" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <Grid Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RECOMPENSA / ITEM DA SEMANA" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="TAXA POR BAÚ" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="SUA CHANCE ACUMULADA" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="C/ ESQUADRÃO" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="EM +50 / +100 PARTIDAS" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="5" Text="ESPERADO (E[X])" Style="{StaticResource Label}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,4"/>

                                <ItemsControl x:Name="OddsComparisonList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource HoverRow}" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="6,7" ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.1*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.35*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ItemName}" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding BaseRate}" FontFamily="{StaticResource Display}" Foreground="{StaticResource Steel}" FontSize="17" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding SoloChance}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="13"/>
                                                        <Grid Height="4.5" Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding FillStar}"/>
                                                                <ColumnDefinition Width="{Binding EmptyStar}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="2"/>
                                                            <Border Grid.Column="1" Background="#1CFFFFFF" CornerRadius="2"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding SquadChance}" Foreground="{StaticResource Cyan}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Projections}" Foreground="{StaticResource Emerald}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding ExpectedText}" Foreground="{StaticResource Steel}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== WORKSPACE 3: PARTIDAS & SOBREPOSIÇÃO ==================== -->
                <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid x:Name="HistoryGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HistoryLeftCol" Width="*"/>
                            <ColumnDefinition x:Name="HistoryRightCol" Width="380"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Complete Match-by-Match Audit Log -->
                        <Border x:Name="HistoryLeftBorder" Grid.Column="0" Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,14,0" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="190" Margin="0,0,8,0">
                                            <TextBox x:Name="HistorySearchBox" TextChanged="HistorySearchBox_TextChanged" Padding="8,5" FontSize="12"
                                                     ToolTip="Busque por tipo de baú, modo, parceiro, data ou tesouro"/>
                                            <TextBlock x:Name="HistorySearchPlaceholder" Text="Buscar partida ou baú…"
                                                       Foreground="#667085" FontSize="11.5" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                        <Button Content="Exportar CSV" Style="{StaticResource Quiet}" Padding="11,5" Click="ExportCsvButton_Click"
                                                ToolTip="Exporta o histórico completo (compatível com Excel em português) para arquivo CSV"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Histórico de partidas" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="HistorySummaryText" Text="" Style="{StaticResource Label}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="6,0,14,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="114"/>
                                            <ColumnDefinition Width="154"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="DATA / HORA" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="MODO" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="SEUS BAÚS" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="4" Text="ESQUADRÃO" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="5" Text="TESOUROS / ORIGEM" Style="{StaticResource Label}" FontSize="10.5" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="MatchListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <StackPanel>
                                        <ItemsControl x:Name="MatchHistoryList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HoverRow}" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="6,7" ToolTip="{Binding Tooltip}">
                                                        <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="114"/>
                                                                <ColumnDefinition Width="154"/>
                                                                <ColumnDefinition Width="78"/>
                                                                <ColumnDefinition Width="102"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{StaticResource Steel}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Mode}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding You}" FontFamily="{StaticResource Display}" Foreground="{StaticResource Gold}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Squad}" Foreground="{StaticResource Steel}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Details}" Foreground="{Binding DetailsBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding KindSummary}" Style="{StaticResource Label}" Margin="48,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="HistoryEmptyFilterText" Text="Nenhuma partida corresponde à busca informada."
                                                   Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,24,0,12" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- System Preferences & Diagnostics -->
                        <ScrollViewer x:Name="HistoryRightScroll" Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Panel}" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Text="Sobreposição &amp; Bandeja" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Personalize estilos transparentes, tamanho, cores, contorno de visibilidade, âncoras do minimapa e fonte do OBS na aba dedicada de Overlay."
