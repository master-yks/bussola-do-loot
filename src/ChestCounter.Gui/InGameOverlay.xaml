<Window x:Class="ChestCounter.Gui.InGameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChestCounter.Gui"
        Title="Bússola do Loot no Jogo"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDrag" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Border x:Name="DragSurface" Background="#01000000" CornerRadius="8" Cursor="SizeAll"
            MouseEnter="DragSurface_MouseEnter" MouseLeave="DragSurface_MouseLeave">
        <local:OverlayHudView x:Name="HudView"/>
    </Border>
</Window>
